generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum SpaceStatus {
  vacant
  booked
  occupied
}

enum ParkingStatus {
  booked
  cancelled
  active
  finished
}

enum RateType {
  day
  night
}

enum PaymentStatus {
  pending
  cancelled
  failed
  success
}

model Space {
  id             String      @id @default(uuid()) @db.Uuid
  displayName    String      @unique
  status         SpaceStatus @default(vacant)
  relatedVehicle String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  parkings       Parking[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Vehicle {
  id                            String   @id @default(uuid()) @db.Uuid
  regNumber                     String   @unique
  vin                           String
  registrationCertificateNumber String
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)
}

model Parking {
  id                String        @id @default(uuid()) @db.Uuid
  status            ParkingStatus @default(booked)
  vehicleRegNumber  String
  spaceId           String        @db.Uuid
  space             Space         @relation(fields: [spaceId], references: [id])
  activeSince       DateTime      @db.Timestamptz(3)
  currentRate       RateType
  latestRateChange  DateTime      @db.Timestamptz(3)
  total             Int           @default(0)
  latestTotalUpdate DateTime      @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  payments          Payment[]

  @@unique([spaceId], map: "parking_open_per_space_key", where: raw("(status = ANY (ARRAY['booked'::\"ParkingStatus\", 'active'::\"ParkingStatus\"]))"))
  @@unique([vehicleRegNumber], map: "parking_open_per_vehicle_key", where: raw("(status = ANY (ARRAY['booked'::\"ParkingStatus\", 'active'::\"ParkingStatus\"]))"))
  @@index([vehicleRegNumber, status])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  parkingId String        @db.Uuid
  parking   Parking       @relation(fields: [parkingId], references: [id])
  total     Int
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([parkingId], map: "payment_open_per_parking_key", where: raw("(status = ANY (ARRAY['pending'::\"PaymentStatus\", 'success'::\"PaymentStatus\"]))"))
  @@index([status])
}
